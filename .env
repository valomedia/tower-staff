#
# .env
# tower-staff
#

# Port to run the app on during development
#
PORT=3001

# Where the app can reach the backend.
#
REACT_APP_TOWER_API_ENDPOINT=/api

# Api key for generating generating static images from Google Maps.
#
#REACT_APP_MAPS_API_KEY=

# Download link for the source code.
#
# If you make a modified version of this sofware,
# you must override this link in .env.local
# to point to a public repository
# hosting your modified code.
#
REACT_APP_SOURCE_URL=https://github.com/valomedia/tower-staff
